VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws

# Optional RTCIceServer JSON. Without this, voice connects on reachable local networks.
# For production, supply your provider's STUN/TURN configuration.
# Vite variables are public: use short-lived TURN credentials, never a provider secret.
VITE_RTC_ICE_SERVERS=[]
